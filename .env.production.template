# CalBook.ai Production Environment Variables
# Copy this file to .env and fill in your values

# ─── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBAPP_URL=https://your-domain.com
NEXT_PUBLIC_AUTH_URL=https://your-domain.com
CALCOM_VERSION=1.0.0

# ─── Database (Neon, Supabase, or any PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/calbook?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/calbook

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://your-domain.com

# ─── Email (Resend, Postmark, or SMTP) ───────────────────────────────────────
# For Resend:
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=noreply@your-domain.com
# For SMTP:
# EMAIL_SERVER_HOST=smtp.your-provider.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-smtp-user
# EMAIL_SERVER_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@your-domain.com

# ─── Stripe Billing ──────────────────────────────────────────────────────────
# Required for hosted subscription checkout. Stripe Connect and webhooks are optional.
STRIPE_PRIVATE_KEY=sk_live_your-stripe-secret-key
# Optional: only needed for Stripe Connect or webhook-driven status updates.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_CLIENT_ID=your-stripe-client-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_EVENT_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your-event-subscription-webhook-secret
# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY=price_your-pro-monthly-price-id
STRIPE_PRICE_ID_PRO_ANNUALLY=price_your-pro-annually-price-id
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_your-enterprise-monthly-price-id
STRIPE_PRICE_ID_ENTERPRISE_ANNUALLY=price_your-enterprise-annually-price-id

# ─── Twilio (SMS automation) ─────────────────────────────────────────────────
TWILIO_SID=your-twilio-account-sid
TWILIO_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Vercel (custom domains) ─────────────────────────────────────────────────
# VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-team-id

# ─── Feature Flags ───────────────────────────────────────────────────────────
HOSTED_CAL_FEATURES=true
